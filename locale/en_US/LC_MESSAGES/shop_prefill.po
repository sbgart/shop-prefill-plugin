msgid "zen.custom_template.tooltip.fmt_a.desc"
msgstr "Hyperlink: put the URL in href and the visible label between the opening and closing tags."

msgid "zen.custom_template.tooltip.fmt_a.example"
msgstr "<a href=\"https://example.com\">Website</a>"

