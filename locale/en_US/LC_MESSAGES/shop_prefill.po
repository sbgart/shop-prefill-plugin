msgid "zen.custom_template.tooltip.cond_if.desc"
msgstr "Replace each «$» with a variable or expression. The part between {if} and {/if} is output only when the condition is true."

msgid "zen.custom_template.tooltip.cond_if.example"
msgstr "{if $company}{$company} • {/if}"

msgid "zen.custom_template.tooltip.cond_else.desc"
msgstr "Two branches: first block if the condition is true, the block after {else} if false. Replace «$» with your expression."

msgid "zen.custom_template.tooltip.cond_else.example"
msgstr "{if $shipping_rate}{$shipping_rate}{else}—{/if}"

msgid "zen.custom_template.tooltip.cond_and.desc"
msgstr "Both sides must be true. Replace each «$» with a variable or expression (e.g. $firstname and $lastname)."

msgid "zen.custom_template.tooltip.cond_and.example"
msgstr "{if $firstname && $lastname}{$firstname} {$lastname}{/if}"

msgid "zen.custom_template.tooltip.cond_or.desc"
msgstr "At least one side must be true. Replace each «$» with a variable or expression."

msgid "zen.custom_template.tooltip.cond_or.example"
msgstr "{if $phone || $email}{$phone} {$email}{/if}"

msgid "zen.custom_template.tooltip.fmt_strong.desc"
msgstr "Templates may include HTML. Wraps text in <strong> for bold emphasis."

msgid "zen.custom_template.tooltip.fmt_strong.example"
